colvarsTrajFrequency     20000
colvarsRestartFrequency  20000

colvar {
   name AtomDistance
  
   width 0.1
   lowerBoundary 12.0
   upperBoundary 32.0
   
   extendedlagrangian on
   extendedFluctuation __FLUCVALUE__
   extendedTimeConstant 200
   extendedLangevinDamping 2.0
   subtractAppliedForce on

   distance {
      group1 {
         atomnumbers { 10 }
      }
      group2 {
         atomnumbers { 92 }
      }
   }
}

harmonicWalls {
   colvars AtomDistance
   lowerWalls    11.5
   upperWalls    32.5
   forceConstant 10.0
}

abf {
   colvars AtomDistance
   fullSamples   __SAMPVALUE__
   historyFreq 100000
}

metadynamics {
   colvars AtomDistance
   hillWeight 0.1
   hillWidth  3
   wellTempered   on
   biasTemperature   1000
}
